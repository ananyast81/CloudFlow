# Local development starts one worker automatically. Docker sets this to false for the API.
CLOUDFLOW_AUTO_WORKER=true
# CLOUDFLOW_WORKSPACE=/absolute/path/to/workspace
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional reasoning provider: none, groq, or gemini.
# Use a JSON-capable model identifier available in your provider account.
# Restart API and any external worker after changing these values, then enable
# Use AI reasoning for each new run. Configured means present, not live-verified.
# Never put this key in frontend/.env or commit a populated root .env.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional shared tracking server. Defaults to local SQLite with persistent artifacts.
MLFLOW_TRACKING_URI=
