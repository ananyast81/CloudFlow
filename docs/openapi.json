              },
              {
                "type": "null"
              }
            ],
            "title": "Target Column"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "auto",
              "classification",
              "regression"
            ],
            "title": "Task Type",
            "default": "auto"
          },
          "test_size": {
            "type": "number",
            "maximum": 0.4,
            "minimum": 0.1,
            "title": "Test Size",
            "default": 0.2
          },
          "cv_folds": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 2.0,
            "title": "Cv Folds",
            "default": 3
          },
          "max_retries": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Max Retries",
            "default": 1
          },
          "random_state": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Random State",
            "default": 42
          },
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunOptions"
