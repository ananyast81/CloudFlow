        ],
        "title": "Body_preview_api_datasets_preview_post"
      },
      "CandidateResult": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "round": {
            "type": "integer",
            "title": "Round"
          },
          "cv_score": {
            "type": "number",
            "title": "Cv Score"
