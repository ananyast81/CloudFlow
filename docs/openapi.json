  "components": {
    "schemas": {
      "AgentProgress": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "waiting",
              "failed",
              "cancelled"
            ],
            "title": "Status",
            "default": "pending"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": "Waiting for the previous stage."
          },
          "decisions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Decisions"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AgentProgress"
      },
      "AnalysisPlan": {
        "properties": {
          "target_column": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Target Column"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "classification",
              "regression"
            ],
            "title": "Task Type"
          },
          "feature_columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Feature Columns"
          },
          "models": {
            "items": {
              "type": "string",
              "enum": [
                "linear",
                "random_forest",
                "svm",
                "gradient_boosting",
                "xgboost"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Models"
          },
          "numeric_imputation": {
            "type": "string",
            "enum": [
              "median",
              "mean"
            ],
            "title": "Numeric Imputation",
            "default": "median"
          },
          "scale_numeric": {
            "type": "boolean",
            "title": "Scale Numeric",
            "default": true
          },
          "balance_classes": {
            "type": "boolean",
            "title": "Balance Classes",
            "default": true
          },
          "derive_dates": {
            "type": "boolean",
            "title": "Derive Dates",
            "default": true
          },
          "select_features": {
            "type": "boolean",
            "title": "Select Features",
            "default": false
          },
          "primary_metric": {
            "type": "string",
            "enum": [
              "f1_weighted",
              "accuracy",
              "rmse",
              "mae",
              "r2"
            ],
            "title": "Primary Metric"
          },
          "reasoning": {
            "type": "string",
            "maxLength": 4000,
            "title": "Reasoning",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_column",
          "task_type",
          "feature_columns",
          "primary_metric"
        ],
        "title": "AnalysisPlan"
      },
      "Body_create_run_api_runs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "options": {
