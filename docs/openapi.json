          "train_score": {
            "type": "number",
            "title": "Train Score"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "mlflow_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mlflow Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "model_name",
          "round",
          "cv_score",
          "cv_std",
          "train_score",
          "parameters",
          "duration_seconds"
        ],
        "title": "CandidateResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PipelineState": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "options": {
            "$ref": "#/components/schemas/RunOptions"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile": {
            "additionalProperties": true,
            "type": "object",
            "title": "Profile"
          },
          "preparation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Preparation"
          },
          "eda": {
            "additionalProperties": true,
            "type": "object",
            "title": "Eda"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateResult"
            },
            "type": "array",
            "title": "Candidates"
          },
          "selected_candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Candidate Id"
          },
          "evaluation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evaluation"
          },
          "report": {
            "additionalProperties": true,
            "type": "object",
            "title": "Report"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt",
            "default": 0
          },
          "retry": {
            "type": "boolean",
            "title": "Retry",
            "default": false
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "objective",
          "options"
        ],
        "title": "PipelineState"
      },
      "PredictionRequest": {
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Rows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rows"
        ],
        "title": "PredictionRequest"
      },
      "ReviewDecision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "comment": {
            "type": "string",
